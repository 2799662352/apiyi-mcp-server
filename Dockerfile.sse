# API易 MCP Server — SSE 模式 Dockerfile
# 内嵌 mcp-proxy 把内部 stdio 转为 SSE 暴露在 :8080
# 用途: 部署到云端供 Cursor / Codex 通过 URL MCP 远程访问

FROM node:20-slim

# 装 python3 venv (mcp-proxy 是 Python 实现)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates python3 python3-venv \
 && rm -rf /var/lib/apt/lists/*

# 内嵌 mcp-proxy
RUN python3 -m venv /opt/mcp-proxy-venv \
 && /opt/mcp-proxy-venv/bin/pip install --no-cache-dir mcp-proxy \
 && ln -s /opt/mcp-proxy-venv/bin/mcp-proxy /usr/local/bin/mcp-proxy

WORKDIR /app

# 复制 package.json 和锁定文件
COPY package*.json ./

# 装 npm 依赖
RUN npm install --production=false

# 复制源码并编译
COPY . .
RUN npm run build

# 清理 dev deps
RUN npm prune --production

# 默认环境变量 (运行时可覆盖)
ENV APIYI_API_KEY="" \
    APIYI_BASE_URL="https://api.apiyi.com" \
    GEMINI_MODEL="gemini-3.5-flash" \
    GEMINI_TIMEOUT="1800000" \
    GEMINI_MAX_OUTPUT_TOKENS="65536" \
    GEMINI_MAX_FILES="10" \
    GEMINI_MAX_TOTAL_FILE_SIZE="100" \
    GEMINI_TEMPERATURE="0.2" \
    GEMINI_MEDIA_RESOLUTION="MEDIUM"

EXPOSE 8080

# 入口: mcp-proxy 监听 :8080 SSE, 通过 stdio fork node 进程
# 注意: mcp-proxy 0.10+ 用 --port/--host 替代 --sse-port/--sse-host (后者已弃用且实际不生效)
CMD ["mcp-proxy", "--port", "8080", "--host", "0.0.0.0", "--pass-environment", "--", "node", "/app/dist/index.js"]
