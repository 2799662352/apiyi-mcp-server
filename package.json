{
  "name": "apiyi-mcp-server",
  "version": "1.0.0",
  "description": "MCP Server for API易 / Gemini API integration with multimodal file processing support (video, audio, image, PDF)",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "apiyi-mcp-server": "./bin/apiyi-mcp-server"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "rebuild": "npm run clean && npm run build",
    "inspector": "npm run build && npx --yes @modelcontextprotocol/inspector@latest node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gemini",
    "apiyi",
    "api易",
    "multimodal",
    "video-understanding",
    "audio-transcription",
    "image-analysis",
    "pdf-markdown",
    "generative-ai"
  ],
  "author": "Modified from eternnoir/aistudio-mcp-server",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^1.34.0",
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "tsx": "^4.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "bin"
  ]
}
